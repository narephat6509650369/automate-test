{
  "name": "gofive-register-e2e",
  "version": "1.0.0",
  "private": true,
  "description": "Playwright E2E tests for the Gofive / Empeo registration portal (UAT)",
  "scripts": {
    "test": "playwright test",
    "test:headed": "HEADED=1 playwright test --workers=1",
    "test:demo": "HEADED=1 SLOWMO=400 playwright test --workers=1 --project=chromium",
    "test:smoke": "playwright test --grep @smoke",
    "report": "playwright show-report",
    "codegen": "playwright codegen https://portal.uat.gofive.co.th/Register/empeo",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@playwright/test": "^1.52.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  }
}
